[Unit]
Description=Llama Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/home/john
WorkingDirectory=/home/john/llama
ExecStart=/bin/bash /home/john/llama/start-llama.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
